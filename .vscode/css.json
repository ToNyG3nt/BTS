{
  "CSS Reset": {
    "prefix": "cssreset",
    "body": [
      "/* Basic CSS Reset */",
      "* {",
      "  margin: 0;",
      "  padding: 0;",
      "  box-sizing: border-box;",
      "}$0"
    ],
    "description": "Applies a basic CSS reset"
  },
  "Flex Container": {
    "prefix": "flex",
    "body": [
      "display: flex;",
      "flex-direction: ${1|row,column,row-reverse,column-reverse|};",
      "justify-content: ${2|flex-start,flex-end,center,space-between,space-around,space-evenly|};",
      "align-items: ${3|flex-start,flex-end,center,baseline,stretch|};",
      "gap: ${4:10px};$0"
    ],
    "description": "CSS Flexbox container properties"
  },
  "Grid Container": {
    "prefix": "grid",
    "body": [
      "display: grid;",
      "grid-template-columns: ${1:repeat(auto-fit, minmax(250px, 1fr))};",
      "grid-template-rows: ${2:auto};",
      "gap: ${3:10px};$0"
    ],
    "description": "CSS Grid container properties"
  },
  "Media Query": {
    "prefix": "mq",
    "body": [
      "@media screen and (${1|max-width,min-width|}: ${2:768px}) {",
      "  ${3:selector} {",
      "    ${4:property}: ${5:value};",
      "  }",
      "}$0"
    ],
    "description": "CSS Media Query snippet"
  },
  "Font Properties": {
    "prefix": "font",
    "body": [
      "font-family: ${1:Arial, sans-serif};",
      "font-size: ${2:16px};",
      "font-weight: ${3:normal};",
      "line-height: ${4:1.5};$0"
    ],
    "description": "Common font properties"
  }
}